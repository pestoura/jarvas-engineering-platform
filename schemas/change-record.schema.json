{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvas.local/schemas/change-record.schema.json",
  "title": "JDS-002 Change Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "product",
    "classification",
    "state",
    "disposition",
    "summary",
    "source",
    "affectedRelease",
    "risk",
    "versionEffect",
    "validation",
    "timestamps"
  ],
  "properties": {
    "schemaVersion": {"const": "jds.change/v1"},
    "kind": {"const": "ChangeRecord"},
    "id": {"type": "string", "pattern": "^CHG-[A-Z0-9][A-Z0-9-]{2,80}$"},
    "product": {"type": "string", "minLength": 1, "maxLength": 120},
    "classification": {"enum": ["HOTFIX", "BUGFIX", "HARDENING", "IMPROVEMENT", "COMPATIBILITY", "SECURITY_FIX", "BREAKING_CHANGE", "DOC_ONLY"]},
    "state": {"enum": ["DISCOVERED", "TRIAGED", "IMPLEMENTING", "VALIDATING", "ACCEPTED", "PROMOTED", "LIVE_VERIFIED", "CLOSED", "BLOCKED", "REJECTED", "SUPERSEDED", "ROLLED_BACK"]},
    "disposition": {"enum": ["FIX_NOW", "DEFER", "REJECT"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["VALIDATION_CAMPAIGN", "PRODUCTION_INCIDENT", "SECURITY_FINDING", "ENGINEERING_REVIEW", "USER_REQUEST", "DEPENDENCY_CHANGE", "OTHER"]},
        "campaign": {"type": ["string", "null"], "pattern": "^VAL-[A-Z0-9][A-Z0-9-]{2,80}$"},
        "observation": {"type": ["string", "null"], "pattern": "^OBS-[A-Z0-9][A-Z0-9-]{1,80}$"},
        "reference": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "affectedRelease": {"type": "string", "minLength": 1, "maxLength": 80},
    "targetRelease": {"type": ["string", "null"], "maxLength": 80},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "versionEffect": {"enum": ["NONE", "RC_INCREMENT", "PATCH", "MINOR", "MAJOR"]},
    "branch": {"type": ["string", "null"], "maxLength": 200},
    "issue": {"type": ["integer", "null"], "minimum": 1},
    "pr": {"type": ["integer", "null"], "minimum": 1},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targeted", "regression", "security", "runtime"],
      "properties": {
        "targeted": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]},
        "regression": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]},
        "security": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]},
        "runtime": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "artifactDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "previousRelease": {"type": ["string", "null"], "maxLength": 80}
      }
    },
    "deferredTo": {"type": ["string", "null"], "maxLength": 80},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoveredAt", "updatedAt"],
      "properties": {
        "discoveredAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "closedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
